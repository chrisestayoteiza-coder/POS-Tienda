{
  "name": "pos-tienda",
  "version": "1.0.0",
  "description": "Punto de venta de escritorio para tienda: venta con lector de código, caja, inventario, compras y reportes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "cl.tienda.pos",
    "productName": "Punto de Venta",
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "auth.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "license": "UNLICENSED",
  "private": true
}